  <remote name="los"    fetch="https://github.com/LineageOS" />
  <remote name="rocky" fetch="https://github.com/Rocky7842" />

  <!-- 设备相关：指向自己的 fork（带本地补丁，不要改成上游） -->
  <project name="Rocky7842_android_device_samsung_d1x"                      path="device/samsung/d1x"                     remote="mcajun" revision="crdroid-17.0" />
  <project name="Rocky7842_android_device_samsung_exynos9820-common"        path="device/samsung/exynos9820-common"       remote="mcajun" revision="lineage-24.0" />
  <project name="Rocky7842_proprietary_vendor_samsung_d1x"                  path="vendor/samsung/d1x"                     remote="mcajun" revision="lineage-24.0" />
  <project name="Rocky7842_proprietary_vendor_samsung_exynos9820-common"    path="vendor/samsung/exynos9820-common"       remote="mcajun" revision="lineage-24.0" />
  <!-- [d1x] 内核改用 Rocky7842 官方的 KernelSU-Next 分支（不含 SukiSU/SUSFS）；
       SUSFS 由我们在自己的分支 d1x-susfs 上集成后再改 revision 指过去。 -->
  <!-- [d1x] 内核用自己 fork 的 KernelSU-Next 分支（已与官方 lineage-24.0-ksu 同步）；
       SUSFS 等集成提交到自己的 d1x-susfs 分支后再改这个 revision。 -->
  <project name="Rocky7842_android_kernel_samsung_exynos9820"               path="kernel/samsung/exynos9820"              remote="mcajun" revision="lineage-24.0-ksu" />

  <!-- 上游依赖：优先用镜像（同步 workflow 会保持它们与 LineageOS 一致） -->
  <project name="android_device_samsung_slsi_sepolicy"                      path="device/samsung_slsi/sepolicy"           remote="mcajun" revision="lineage-24.0" />

  <!-- d1x: CarrierConfig 换成我们自己的镜像（加了中国大陆 460xx 配置）。
       AOSP 那 411 个 assets 里没有任何 460xx，导致所有国内卡都取
       carrier_volte_available_bool=false，IMS 根本不注册。
       这些 XML 必须在这个 APK 的 assets/ 里，PRODUCT_COPY_FILES 塞不进去，
       所以只能把整个 project 换源。 -->
  <remove-project name="platform/packages/apps/CarrierConfig" />
  <project name="aosp_packages_apps_CarrierConfig"                          path="packages/apps/CarrierConfig"            remote="mcajun" revision="main" />
